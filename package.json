{
  "name": "@iankha/design-system",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "description": "Iankha design system — tokens and React components, generated from the Iankha-Design-System-New Figma file.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/style.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:storybook": "storybook build",
    "tokens:transform": "node scripts/transform-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "changeset": "changeset",
    "release": "changeset publish",
    "figma:connect": "figma connect publish"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.6.0",
    "lucide-react": "^1.31.0",
    "@radix-ui/react-slot": "^1.3.3"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@figma/code-connect": "^1.5.2",
    "@storybook/addon-a11y": "^10.5.7",
    "@storybook/react-vite": "^10.5.7",
    "@types/node": "^26.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.5.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3"
  }
}
