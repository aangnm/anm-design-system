{
  "name": "@anm/design-system",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "anm design system — tokens and React components for building products in Figma or in code, by hand or with AI agents, with a dedicated set for analytics dashboards.",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "storybook dev -p 6006",
    "build": "tsc -p tsconfig.build.json && vite build",
    "build:storybook": "node scripts/build-llms.mjs && storybook build",
    "docs:llms": "node scripts/build-llms.mjs",
    "tokens:transform": "node scripts/transform-tokens.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --project=storybook-dark && vitest run --project=storybook-light && vitest run --project=storybook-high-contrast",
    "changeset": "changeset",
    "release": "changeset publish"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.31.0",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@storybook/addon-a11y": "^10.6.7",
    "@storybook/addon-docs": "^10.6.7",
    "@storybook/addon-vitest": "^10.6.7",
    "@storybook/react-vite": "^10.6.7",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/browser-playwright": "^5.1.0",
    "@vitest/coverage-v8": "^5.1.0",
    "playwright": "^1.65.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "storybook": "^10.6.7",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.0",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vitest": "^5.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aangnm/anm-design-system.git"
  },
  "homepage": "https://github.com/aangnm/anm-design-system"
}
